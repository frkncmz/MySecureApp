{
  "expo": {
    "name": "LoveLog",
    "slug": "LoveLog",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/ios.png",
    "scheme": "lovelog",
    "userInterfaceStyle": "light",
